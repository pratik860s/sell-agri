# ─────────────────────────────────────────────────────────────────────────────
#  Rajat Kisan — environment variables
#
#  Local development : copy this file to .env.local and fill in the ADMIN_* and
#                      JWT_SECRET values. Leave the GITHUB_* block commented out
#                      so admin edits write to ./data/*.json on your disk.
#
#  Vercel production : set every variable below in
#                      Project → Settings → Environment Variables
#                      for Production, Preview AND Development.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin sign-in ────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin

# A bcrypt HASH, never the plain password. Generate one with:
#     npm run hash -- 'your-strong-password'
# The value contains $ characters — quote it if you ever put it in a shell script.
ADMIN_PASSWORD_HASH=$2a$10$replace.this.with.the.hash.you.generated

# ── Session signing ──────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
#     npm run secret
JWT_SECRET=replace_with_a_64_character_random_hex_string_from_npm_run_secret

# ── GitHub = the database (production only) ──────────────────────────────────
# Vercel's filesystem is read-only, so admin writes are committed back to the
# repo instead. Create a FINE-GRAINED personal access token at
#   github.com → Settings → Developer settings → Fine-grained tokens
#   · Repository access : Only select repositories → this repo
#   · Permissions       : Repository → Contents → Read and write
# Leave these unset locally to write to ./data/*.json directly.
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=sell-agri
# GITHUB_BRANCH=main

# ── Public values ────────────────────────────────────────────────────────────
# Anything prefixed VITE_ is bundled into the browser JavaScript. Never put a
# token or secret behind a VITE_ prefix.
#
# The WhatsApp number, YouTube URL and contact details are deliberately NOT here
# — they live in data/settings.json so you can change them from the admin panel
# without a redeploy.
